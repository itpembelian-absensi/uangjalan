{
  "name": "uang-pengiriman",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-backend.cjs",
    "dev": "node scripts/run-dev-watch.cjs",
    "dev:fast": "node scripts/dev-once.cjs",
    "dev:legacy": "concurrently -n backend,frontend -c blue,magenta \"node scripts/run-backend-watch.cjs\" \"npm run dev --prefix frontend\"",
    "dev:backend": "node scripts/ensure-backend.cjs && node scripts/run-backend-watch.cjs",
    "dev:frontend": "npm run dev --prefix frontend",
    "setup": "node scripts/ensure-backend.cjs",
    "stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-dev.ps1",
    "postinstall": "npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10"
  }
}
