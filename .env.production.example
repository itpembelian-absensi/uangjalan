# === Docker Compose + Backend App ===
# File ini di-rename jadi .env di server
# Dibaca oleh docker-compose.yml DAN backend app (via volume mount)

# Database
DB_PASSWORD=ganti-password-postgres

# Backend App
DATABASE_URL=postgresql+pg8000://postgres:ganti-password-postgres@db:5432/uang_pengiriman
APP_NAME=Uang Pengiriman
ALLOW_ORIGINS=http://localhost:3215
SESSION_SECRET=ganti-dengan-random-string-32-karakter
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-admin
GOOGLE_MAPS_API_KEY=
