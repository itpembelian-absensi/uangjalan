DATABASE_URL=postgresql+pg8000://postgres:password@localhost:5432/uang_pengiriman

APP_NAME=Uang Pengiriman

ALLOW_ORIGINS=http://localhost:5173,http://localhost:8000

SESSION_SECRET=ubah-key-ini

ADMIN_USERNAME=admin

ADMIN_PASSWORD=admin



# Mode: set to "production" to disable DB Tools
# MODE=production

# Google Maps Routes API (opsional)
# - Tarif tol aktual
# - Jarak BBM mendekati Google Maps (jarak berkendara langsung)
GOOGLE_MAPS_API_KEY=

# OSRM — perhitungan rute & tol otomatis (default: server publik)
# Untuk production stabil, gunakan OSRM self-hosted, contoh:
# OSRM_BASE_URL=http://localhost:5000/route/v1/driving
OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving
OSRM_HTTP_TIMEOUT=30
OSRM_MAX_RETRIES=2

# Acuan tarif tol Jabodetabek (Gol II/III dan Gol IV/V per ruas tol)

TOLL_JAPEK_KM=73

TOLL_JAPEK_GOL23=40500

TOLL_JAPEK_GOL45=54000

TOLL_JORR_KM=32

TOLL_JORR_GOL23=25000

TOLL_JORR_GOL45=33500

TOLL_JAKARTA_INNER_KM=15

TOLL_JAKARTA_INNER_GOL23=16500

TOLL_JAKARTA_INNER_GOL45=19000

TOLL_JAGORAWI_KM=45

TOLL_JAGORAWI_GOL23=12000

TOLL_JAGORAWI_GOL45=17000

